rules_version = '2';

// Cada usuário só lê e escreve as próprias tarefas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /tarefas/{tarefaId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // resource == null: tarefa criada e excluída offline, que nunca chegou à nuvem.
      allow delete: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.titulo is string;

      // Não permite trocar o dono da tarefa.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }
  }
}
